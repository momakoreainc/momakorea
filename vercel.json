{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/new", "destination": "/new/index.html" },
    { "source": "/new/(.*)", "destination": "/new/index.html" },
    { "source": "/new2", "destination": "/new/index.html" },
    { "source": "/new2/(.*)", "destination": "/new/index.html" }
  ]
}
